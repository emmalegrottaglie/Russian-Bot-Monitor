# Copy to .env and fill in what you have. Every source is optional except IODA,
# which needs no key. Missing credentials disable that source; nothing is faked.

# SQLite file. The directory is created on start.
TRACKER_DB=data/tracker.db

# Public URL of the site, used in alert posts.
TRACKER_PUBLIC_URL=https://example.org

# Minutes between collection passes when running `python -m tracker serve`.
TRACKER_INTERVAL_MIN=15

# Cloudflare Radar: create a free API token with the "Radar: Read" permission.
CLOUDFLARE_API_TOKEN=

# Reddit OAuth (script or web app, client-credentials grant). Without these the
# collector falls back to the public RSS feeds, which are slower and less reliable.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit requires a descriptive user agent: <platform>:<app id>:<version> (by /u/<username>)
REDDIT_USER_AGENT=web:bot-traffic-monitor:0.1 (by /u/your_username)

# X (Twitter) alert account, OAuth 1.0a user context. Leave blank to only log
# alerts on the site. Set TRACKER_POST_ALERTS=1 to actually post.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
TRACKER_POST_ALERTS=0

# X API app-only Bearer Token, for reading post counts (pay-per-use; set a
# spending limit in the X Developer Console). Leave blank to skip X.
X_BEARER_TOKEN=
TRACKER_MAX_POSTS_PER_DAY=4
